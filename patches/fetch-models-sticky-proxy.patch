+// isProxyConfigError reports whether the error originates from proxy URL parsing/validation.
+func isProxyConfigError(err error) bool {
+	if err == nil {
+		return false
+	}
+	msg := err.Error()
+	return strings.Contains(msg, "proxy URL") || strings.Contains(msg, "invalid proxy") || strings.Contains(msg, "unsupported proxy")
+}
+
+func isRetryableFetchError(err error) bool {
+	if err == nil {
+		return false
+	}
+	msg := err.Error()
+	if isProxyConfigError(err) {
+		return false
+	}
+	// 401/403 auth, 429 rate-limit, 5xx transient are worth retrying with next key.
+	if strings.Contains(msg, "status code: 401") || strings.Contains(msg, "status code: 403") || strings.Contains(msg, "status code: 429") {
+		return true
+	}
+	if strings.Contains(msg, "status code: 5") {
+		// exclude 501/502 from blind retry? keep retry for transient 5xx; caller decides fallback.
+		// 500/502/503 are often transient upstream issues.
+		return true
+	}
+	return false
+}
+
+func orderedEnabledKeys(channel *model.Channel) []string {
+	keys := channel.GetKeys()
+	if len(keys) == 0 {
+		return nil
+	}
+	if !channel.ChannelInfo.IsMultiKey {
+		trimmed := strings.TrimSpace(channel.Key)
+		if trimmed != "" {
+			return []string{trimmed}
+		}
+		return keys
+	}
+	statusList := channel.ChannelInfo.MultiKeyStatusList
+	filtered := make([]string, 0, len(keys))
+	for idx, k := range keys {
+		k = strings.TrimSpace(k)
+		if k == "" {
+			continue
+		}
+		if statusList != nil {
+			if st, ok := statusList[idx]; ok && st != common.ChannelStatusEnabled {
+				continue
+			}
+		}
+		filtered = append(filtered, k)
+	}
+	return filtered
+}
+
+func resolveProxyForKey(rawProxy string, key string) string {
+	return common.ResolveProxyURL(rawProxy, key)
+}
