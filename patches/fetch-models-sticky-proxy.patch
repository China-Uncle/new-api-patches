 }
 
+// ResolveProxyURL replaces sticky proxy placeholders ({KEY}/{key}/{{KEY}}) with the given key.
+// It handles socks5h://Default.{KEY}:pass@host:port style sticky sessions where each key maps to a
+// dedicated proxy user. Key is percent-encoded for safe embedding in userinfo.
+func ResolveProxyURL(rawProxyURL string, key string) string {
+	if rawProxyURL == "" {
+		return rawProxyURL
+	}
+	key = strings.TrimSpace(key)
+	if key == "" {
+		return rawProxyURL
+	}
+	hasPlaceholder := strings.Contains(rawProxyURL, "{KEY}") || strings.Contains(rawProxyURL, "{key}") ||
+		strings.Contains(rawProxyURL, "{{KEY}}") || strings.Contains(rawProxyURL, "{{key}}") ||
+		strings.Contains(rawProxyURL, "${KEY}") || strings.Contains(rawProxyURL, "${key}")
+	if !hasPlaceholder {
+		return rawProxyURL
+	}
+	// Encode key for userinfo: QueryEscape encodes ':', '@', '/', etc; replace '+' with '%20' for userinfo.
+	encodedKey := strings.ReplaceAll(url.QueryEscape(key), "+", "%20")
+	replacements := []string{
+		"{{KEY}}", encodedKey,
+		"{{key}}", encodedKey,
+		"${KEY}", encodedKey,
+		"${key}", encodedKey,
+		"{KEY}", encodedKey,
+		"{key}", encodedKey,
+	}
+	resolved := rawProxyURL
+	for i := 0; i < len(replacements); i += 2 {
+		if strings.Contains(resolved, replacements[i]) {
+			resolved = strings.ReplaceAll(resolved, replacements[i], replacements[i+1])
+		}
+	}
+	// Re-parse to normalize and ensure url.Parse succeeds (handles any remaining edge cases).
+	if parsed, err := url.Parse(resolved); err == nil && parsed.User != nil {
+		username := parsed.User.Username()
+		if password, hasPass := parsed.User.Password(); hasPass {
+			parsed.User = url.UserPassword(username, password)
+			return parsed.String()
+		}
+		parsed.User = url.User(username)
+		return parsed.String()
+	}
+	return resolved
+}
+
+// sanitizeProxyURLLine takes the first non-empty line to be compatible with pasted multi-line proxies.
+func sanitizeProxyURLLine(raw string) string {
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return raw
+	}
+	if idx := strings.IndexAny(raw, "\r\n"); idx >= 0 {
+		for _, line := range strings.Split(raw, "\n") {
+			line = strings.TrimSpace(strings.Trim(line, "\r"))
+			if line != "" {
+				return line
+			}
+		}
+	}
+	if fields := strings.Fields(raw); len(fields) > 0 && len(fields[0]) != len(raw) {
+		return fields[0]
+	}
+	return raw
+}
+
 func parseProxyURL(rawProxyURL string, allowLegacySuffix bool) (*url.URL, bool, error) {
-	trimmedProxyURL := strings.TrimSpace(rawProxyURL)
+	trimmedProxyURL := sanitizeProxyURLLine(rawProxyURL)
 	if trimmedProxyURL == "" {
 		return nil, false, nil
 	}
